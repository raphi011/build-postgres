-- Errors: type, arity, NOT NULL, unknown and repeated columns.
INSERT INTO t VALUES (9, 9);
ERROR:  column "b" is of type text but expression is of type integer
LINE 1: INSERT INTO t VALUES (9, 9);
                                 ^
INSERT INTO t VALUES (NULL, 'x');
ERROR:  null value in column "a" of relation "t" violates not-null constraint
INSERT INTO t (b) VALUES ('x');
ERROR:  null value in column "a" of relation "t" violates not-null constraint
INSERT INTO t VALUES (1, 'x', true, 1, 2);
ERROR:  INSERT has more expressions than target columns
LINE 1: INSERT INTO t VALUES (1, 'x', true, 1, 2);
                                               ^
INSERT INTO t (a, b, c, d, a) VALUES (1, 'x', true, 1, 2);
ERROR:  column "a" specified more than once
LINE 1: INSERT INTO t (a, b, c, d, a) VALUES (1, 'x', true, 1, 2);
                                   ^
INSERT INTO t (a, a) VALUES (1, 2);
ERROR:  column "a" specified more than once
LINE 1: INSERT INTO t (a, a) VALUES (1, 2);
                          ^
INSERT INTO t (a, z) VALUES (1, 2);
ERROR:  column "z" of relation "t" does not exist
LINE 1: INSERT INTO t (a, z) VALUES (1, 2);
                          ^
INSERT INTO t (a, b) VALUES (1);
ERROR:  INSERT has more target columns than expressions
LINE 1: INSERT INTO t (a, b) VALUES (1);
                          ^
INSERT INTO t VALUES (2147483648, 'big');
ERROR:  column "a" is of type integer but expression is of type bigint
LINE 1: INSERT INTO t VALUES (2147483648, 'big');
                              ^
INSERT INTO t VALUES ('x', 'y');
ERROR:  invalid input syntax for type integer: "x"
LINE 1: INSERT INTO t VALUES ('x', 'y');
                              ^
